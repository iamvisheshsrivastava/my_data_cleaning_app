# Copy this file to .env and fill in real values.
# Do not commit the real .env file.

# OpenRouter API key used by the Streamlit app and metadata inference helpers
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model (defaults to z-ai/glm-4.6)
OPENROUTER_MODEL=z-ai/glm-4.6

# Optional custom LLM endpoint used by LLM/config.py and the Streamlit custom LLM panel
CUSTOM_LLM_API_URL=http://localhost:9000/generate
