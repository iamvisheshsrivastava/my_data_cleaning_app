# Copy this file to .env and fill in real values.
# Do not commit the real .env file.

# Gemini API key used by the Streamlit app and metadata inference helpers
GEMINI_API_KEY=

# Optional custom LLM endpoint used by LLM/config.py and the Streamlit custom LLM panel
CUSTOM_LLM_API_URL=http://localhost:9000/generate
